# Stage 1 Personalized Script Humanizer configuration
# Default: Local Ollama running Gemma (100% free, private, fast on RTX 5060 8GB VRAM)
# Install Ollama: winget install Ollama.Ollama
# Pull model:     ollama pull gemma3:4b
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
HUMANIZER_MODEL=gemma3:4b

# Optional alternative: Cloud OpenAI / Gemini OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=your_api_key_here
# HUMANIZER_MODEL=gemini-2.5-flash
